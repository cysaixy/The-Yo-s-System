generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
//  Lean 12-table restaurant schema.
//  Ingredient tracking is preserved: a product's raw-material recipe lives in
//  Product.ingredients (jsonb), e.g.
//    [{ "inventoryId": 4, "quantity": 18, "unit": "g" }, ...]
//  pointing at raw-material rows in Inventory (itemType = 'raw_material').
//  This replaces the old menu_item_inventory + addon_inventory tables while
//  keeping the model at 12 tables. (No budgets table — feature removed.)
// ============================================================================

model Customer {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(150)
  email       String   @unique @db.VarChar(150)
  phone       String?  @db.VarChar(30)
  password    String?  @db.VarChar(255)
  firebaseUid String?  @map("firebase_uid") @db.VarChar(150)
  createdAt   DateTime @default(now()) @map("created_at")

  orders       Order[]
  reservations Reservation[]

  @@map("customers")
}

model Staff {
  id                 Int      @id @default(autoincrement())
  name               String   @db.VarChar(150)
  email              String   @unique @db.VarChar(150)
  password           String   @db.VarChar(255)
  role               String   @db.VarChar(50)
  status             String   @db.VarChar(30)
  canAccessInventory Boolean  @default(false) @map("can_access_inventory")
  canAccessStockIn   Boolean  @default(false) @map("can_access_stock_in")
  canAccessReports   Boolean  @default(false) @map("can_access_reports")
  createdAt          DateTime @default(now()) @map("created_at")

  orders                Order[]
  inventoryTransactions InventoryTransaction[]
  cashTransactions      CashTransaction[]

  @@map("staff")
}

model RestaurantTable {
  id        Int       @id @default(autoincrement())
  tableNo   String    @unique @map("table_no") @db.VarChar(20)
  capacity  Int
  status    String    @db.VarChar(30)
  createdAt DateTime? @default(now()) @map("created_at")

  reservations Reservation[]

  @@map("tables")
}

model Product {
  id              Int       @id @default(autoincrement())
  productType     String    @map("product_type") @db.VarChar(20)
  category        String?   @db.VarChar(100)
  name            String    @db.VarChar(150)
  description     String?
  price           Decimal   @db.Decimal(10, 2)
  cost            Decimal?  @db.Decimal(10, 2)
  imageUrl        String?   @map("image_url") @db.VarChar(255)
  stockQuantity   Int?      @map("stock_quantity")
  discountPercent Decimal?  @map("discount_percent") @db.Decimal(5, 2)
  components      Json?     @db.JsonB
  ingredients     Json?     @db.JsonB
  status          String?   @db.VarChar(30)
  createdAt       DateTime? @default(now()) @map("created_at")

  orderItems     OrderItem[]
  inventoryLinks Inventory[]

  @@map("products")
}

model Inventory {
  id            Int       @id @default(autoincrement())
  itemType      String    @map("item_type") @db.VarChar(20)
  productId     Int?      @map("product_id")
  name          String    @db.VarChar(150)
  category      String?   @db.VarChar(100)
  sku           String?   @db.VarChar(50)
  unit          String?   @db.VarChar(30)
  stockQuantity Decimal   @map("stock_quantity") @db.Decimal(10, 2)
  unitCost      Decimal   @map("unit_cost") @db.Decimal(10, 2)
  reorderLevel  Decimal?  @map("reorder_level") @db.Decimal(10, 2)
  supplier      String?   @db.VarChar(150)
  status        String?   @db.VarChar(30)
  notes         String?
  createdAt     DateTime? @default(now()) @map("created_at")

  product      Product?               @relation(fields: [productId], references: [id])
  transactions InventoryTransaction[]

  @@map("inventory")
}

model InventoryTransaction {
  id              Int       @id @default(autoincrement())
  inventoryId     Int       @map("inventory_id")
  staffId         Int       @map("staff_id")
  transactionType String    @map("transaction_type") @db.VarChar(30)
  quantityChange  Int       @map("quantity_change")
  expirationDate  DateTime? @map("expiration_date") @db.Date
  referenceId     Int?      @map("reference_id")
  transactionDate DateTime  @default(now()) @map("transaction_date")
  remarks         String?

  inventory Inventory @relation(fields: [inventoryId], references: [id])
  staff     Staff     @relation(fields: [staffId], references: [id])

  @@map("inventory_transactions")
}

model Order {
  id                 Int      @id @default(autoincrement())
  customerId         Int      @map("customer_id")
  staffId            Int?     @map("staff_id")
  reservationId      Int?     @map("reservation_id")
  orderType          String   @map("order_type") @db.VarChar(30)
  status             String   @db.VarChar(30)
  totalAmount        Decimal  @map("total_amount") @db.Decimal(10, 2)
  datetimeOrdered    DateTime @default(now()) @map("datetime_ordered")
  notes              String?
  deliveryFee        Decimal  @default(0) @map("delivery_fee") @db.Decimal(10, 2)
  paymentMethod      String?  @map("payment_method") @db.VarChar(30)
  fulfillmentDetails Json?    @map("fulfillment_details") @db.JsonB

  customer    Customer     @relation(fields: [customerId], references: [id])
  staff       Staff?       @relation(fields: [staffId], references: [id])
  reservation Reservation? @relation(fields: [reservationId], references: [id])
  orderItems  OrderItem[]
  payments    Payment[]

  @@map("orders")
}

model OrderItem {
  id                Int      @id @default(autoincrement())
  orderId           Int      @map("order_id")
  productId         Int      @map("product_id")
  quantity          Int
  price             Decimal  @db.Decimal(10, 2)
  cost              Decimal  @db.Decimal(10, 2)
  subtotal          Decimal  @db.Decimal(10, 2)
  parentOrderItemId Int?     @map("parent_order_item_id")
  notes             String?

  order           Order       @relation(fields: [orderId], references: [id])
  product         Product     @relation(fields: [productId], references: [id])
  parentOrderItem OrderItem?  @relation("OrderItemAddOns", fields: [parentOrderItemId], references: [id])
  addOns          OrderItem[] @relation("OrderItemAddOns")

  @@map("order_items")
}

model Reservation {
  id                   Int       @id @default(autoincrement())
  customerId           Int       @map("customer_id")
  tableNo              String?   @map("table_no") @db.VarChar(20)
  reservationDate      DateTime  @map("reservation_date") @db.Date
  reservationTime      DateTime  @map("reservation_time") @db.Time
  guests               Int
  status               String    @db.VarChar(30)
  orderEditingDeadline DateTime? @map("order_editing_deadline") @db.Date
  notes                String?
  datetimeReserved     DateTime  @default(now()) @map("datetime_reserved")
  statusHistory        Json?     @map("status_history") @db.JsonB

  customer Customer         @relation(fields: [customerId], references: [id])
  table    RestaurantTable? @relation(fields: [tableNo], references: [tableNo])
  orders   Order[]

  @@map("reservations")
}

model Payment {
  id              Int       @id @default(autoincrement())
  orderId         Int       @map("order_id")
  paymentMethod   String    @map("payment_method") @db.VarChar(30)
  amount          Decimal   @db.Decimal(10, 2)
  datetimePaid    DateTime? @map("datetime_paid")
  referenceNumber String?   @map("reference_number") @db.VarChar(100)
  status          String    @db.VarChar(30)

  order Order @relation(fields: [orderId], references: [id])

  @@map("payments")
}

model CashAccount {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(100)
  accountType String   @map("account_type") @db.VarChar(50)
  balance     Decimal  @default(0) @db.Decimal(10, 2)
  status      String   @db.VarChar(30)
  createdAt   DateTime @default(now()) @map("created_at")

  transactions CashTransaction[]

  @@map("cash_accounts")
}

model CashTransaction {
  id              Int      @id @default(autoincrement())
  cashAccountId   Int      @map("cash_account_id")
  staffId         Int?     @map("staff_id")
  transactionType String   @map("transaction_type") @db.VarChar(30)
  category        String?  @db.VarChar(100)
  amount          Decimal  @db.Decimal(10, 2)
  description     String?
  transactionDate DateTime @default(now()) @map("transaction_date")

  cashAccount CashAccount @relation(fields: [cashAccountId], references: [id])
  staff       Staff?      @relation(fields: [staffId], references: [id])

  @@map("cash_transactions")
}
