{
  "devCommand": "cd backend && npm run dev",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/admin", "destination": "/admin/dashboard", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/pics&vids/:path*", "destination": "/frontend/pics&vids/:path*" },
    { "source": "/admin/:path*", "destination": "/frontend/admin/:path*" },
    { "source": "/", "destination": "/frontend/customer/index.html" },
    { "source": "/:path*", "destination": "/frontend/customer/:path*" }
  ]
}
